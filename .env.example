PORT=3000
APP_ADMIN_USERNAME=
APP_ADMIN_PASSWORD=

# Optional DeepSeek PoW overrides
# DEEPSEEK_BASE_URL=https://chat.deepseek.com
# DEEPSEEK_API_VERSION=v0
# DEEPSEEK_POW_WASM_URL=https://fe-static.deepseek.com/chat/static/sha3_wasm_bg.7b9ca65ddd.wasm
# DEEPSEEK_POW_PREFETCH_COUNT=1

# Optional DeepSeek client headers
# DEEPSEEK_CLIENT_BUNDLE_ID=com.deepseek.chat
# DEEPSEEK_CLIENT_VERSION=2.2.0
# DEEPSEEK_CLIENT_PLATFORM=web
# DEEPSEEK_CLIENT_LOCALE=zh_CN
# DEEPSEEK_TIMEZONE_OFFSET=28800
# DEEPSEEK_DEFAULT_AREA_CODE=+86
# DEEPSEEK_USER_AGENT=
# DEEPSEEK_SEC_CH_UA=
# DEEPSEEK_SEC_CH_UA_MOBILE=?0
# DEEPSEEK_SEC_CH_UA_PLATFORM="Windows"

# Optional simulated client profile pools (comma-separated; one profile is
# generated and persisted per bound account)
# DEEPSEEK_PROFILE_PLATFORMS=Windows,macOS,Linux
# DEEPSEEK_PROFILE_CHROME_VERSIONS=126,127,128,129,130
# DEEPSEEK_PROFILE_SOURCES=chat-web,chat-web-v2,chat-web-v3
# DEEPSEEK_PROFILE_SCREEN_SIZES=[[1920,1080],[1536,864],[1440,900]]
# DEEPSEEK_PROFILE_GPU_VENDORS=Generic GPU Vendor
# DEEPSEEK_PROFILE_GPU_RENDERERS=Generic GPU Renderer
# DEEPSEEK_PROFILE_HARDWARE_CONCURRENCY=4,6,8,12,16
# DEEPSEEK_PROFILE_DEVICE_MEMORY=4,8,16

# Optional protocol challenge pacing
# DEEPSEEK_RISK_MAX_RETRIES=2
# DEEPSEEK_RISK_BASE_DELAY_MS=750
# DEEPSEEK_RISK_JITTER_MS=500
# CHAIN_OF_THOUGHT_OVERRIDE_ENABLED=false

# Optional Shumei verification constants
# SHUMEI_ORGANIZATION=P9usCUBauxft8eAmUXaZ
# SHUMEI_CAPTCHA_BASE_URL=https://captcha1.fengkongcloud.cn
# SHUMEI_CAPTCHA_ASSET_BASE_URL=https://castatic.fengkongcloud.cn

# Privacy/security defaults
# PERSIST_ACCOUNT_CREDENTIALS=false

# Optional captcha handling settings. Automatic solving is disabled unless explicitly enabled.
# YESCAPTCHA_ENDPOINT=https://api.yescaptcha.com
# YESCAPTCHA_KEY=
# CAPTCHA_AUTO_SOLVE=false
# CAPTCHA_VISION_FALLBACK=true
# CAPTCHA_MAX_RETRIES=3
# CAPTCHA_COOLDOWN_MS=60000
